# Normalize line endings: LF in the repository; scripts/configs LF everywhere
# (uci-defaults and shell scripts are executed on the router / in CI).
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.config text eol=lf
files/etc/uci-defaults/* text eol=lf

# Binary artifacts (must never appear in the tree)
*.itb binary
*.img binary
*.img.gz binary
*.bin binary
*.dat binary
*.db binary
*.png binary
*.jpg binary
*.gz binary
